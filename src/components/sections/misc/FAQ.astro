---
import FAQAccordion from "./FAQAccordion.tsx";
import { renderFaqAnswerWithLinks, type FaqLink } from "@utils/faqAnswer";

// Define props from Astro
const { title, items } = Astro.props;

// Define TypeScript interface for props
interface Faq {
  question: string;
  answer: string;
  links?: FaqLink[];
}

interface FaqGroup {
  subTitle?: string;
  items: Faq[];
}

interface Props {
  title: string;
  items: FaqGroup;
}
const entries = items.items.map(({ question, answer, links }) => ({
  question,
  answerHtml: renderFaqAnswerWithLinks(answer, links),
}));
---

<!-- Main container that holds all content. Customized for different viewport sizes. -->
<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div class="grid gap-10 md:grid-cols-5" id="faq">
    <div class="md:col-span-2">
      <div class="max-w-xs">
        <h2
          class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
        >
          <Fragment set:html={title} />
        </h2>
        <p class="mt-1 hidden text-neutral-600 dark:text-neutral-400 md:block">
          {items.subTitle}
        </p>
      </div>
    </div>
    <!-- FAQ accordion items -->
    <div class="md:col-span-3">
      <FAQAccordion client:load entries={entries} />
    </div>
  </div>
</section>
