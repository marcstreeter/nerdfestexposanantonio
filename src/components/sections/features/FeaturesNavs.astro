---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import FeatureTabs from "./FeatureTabs.tsx";

interface Props {
  title?: string;
  tabs: {
    heading: string;
    content: string;
    svg: string;
    src: ImageMetadata;
    alt: string;
    first?: boolean;
    second?: boolean;
  }[];
}

const { title, tabs } = Astro.props;
const images = await Promise.all(
  tabs.map(async ({ src, ...tab }) => {
    const image = await getImage({ src, format: "avif" });
    return {
      ...tab,
      src: image.src,
      width: image.attributes.width,
      height: image.attributes.height,
    };
  }),
);
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div class="relative p-6 md:p-16">
    <FeatureTabs client:load tabs={images}>
      <Fragment set:html={title} />
    </FeatureTabs>

    <div class="absolute inset-0 grid h-full w-full grid-cols-12">
      <div
        class="col-span-full h-5/6 w-full rounded-xl bg-neutral-100 dark:bg-white/[.075] sm:h-3/4 lg:col-span-7 lg:col-start-6 lg:h-full"
      >
      </div>
    </div>
  </div>
</section>
