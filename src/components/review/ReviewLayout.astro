---
import SiteMenu from "./SiteMenu.tsx";
import { heroArtOptions } from "./hero-art";
import "@components/ui/forms/controls.css";
import "./palettes.css";
import "./theme.css";
import "./review.css";

interface Props {
  title: string;
  preview?: boolean;
}

const { title, preview = true } = Astro.props;
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const base = `${siteBase}review/`;
const signupPath = `${siteBase}volunteer/`.replace(/\/$/, "");
const home = preview ? base : siteBase;
const path = Astro.url.pathname.replace(/\/$/, "");
const onHome = path === base.slice(0, -1);
const eventsPage = path.endsWith("/events");
const venueDirections =
  "https://www.google.com/maps/dir/?api=1&destination=3644+Talley+Rd,+San+Antonio,+TX";
const palettes = [
  { value: "warm", label: "Warm Refresh" },
  { value: "classic", label: "Classic Nerdfest" },
  { value: "current", label: "Violet & Lime" },
  { value: "og", label: "The OG" },
];
---

<!doctype html>
<html lang="en" data-page-theme={preview && eventsPage ? "chip" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content={preview && eventsPage
        ? "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
        : "width=device-width, initial-scale=1"}
    />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#241b18" />
    <title>{title} | Nerd Fest + Expo</title>
    <script
      is:inline
      define:vars={{ base, palettes, heroArtOptions, signupPath }}
    >
      const root = document.documentElement;
      const storageKey = "nerdfest-review-palette";
      const url = new URL(location.href);
      const requested = url.searchParams.get("palette");
      const known = (value) =>
        palettes.some((palette) => palette.value === value);
      let saved;
      try {
        saved = localStorage.getItem(storageKey);
      } catch {
        // The palette still follows the URL when browser storage is unavailable.
      }
      root.dataset.palette = known(requested)
        ? requested
        : known(saved)
          ? saved
          : palettes[0].value;
      const heroKey = "nerdfest-review-hero";
      const knownHero = (value) =>
        heroArtOptions.some((option) => option.value === value);
      const requestedHero = url.searchParams.get("hero");
      let savedHero;
      try {
        savedHero = localStorage.getItem(heroKey);
      } catch {
        // The URL can carry the choice without browser storage.
      }
      root.dataset.heroArt = knownHero(requestedHero)
        ? requestedHero
        : knownHero(savedHero)
          ? savedHero
          : heroArtOptions[0].value;
      if (url.searchParams.get("background") === "plain") {
        root.dataset.background = "plain";
      }

      document.addEventListener(
        "DOMContentLoaded",
        () => {
          const themeColor = document.querySelector('meta[name="theme-color"]');
          const links = Array.from(document.querySelectorAll("a[href]")).filter(
            (link) =>
              link.origin === location.origin &&
              (link.pathname.startsWith(base) ||
                link.pathname.replace(/\/$/, "") === signupPath) &&
              !link.getAttribute("href").startsWith("#"),
          );

          function updateThemeColor() {
            themeColor.content = getComputedStyle(root)
              .getPropertyValue("--page")
              .trim();
          }

          function updateLinks() {
            for (const link of links) {
              const target = new URL(link.href);
              target.searchParams.set("palette", root.dataset.palette);
              target.searchParams.set("hero", root.dataset.heroArt);
              if (root.dataset.background === "plain")
                target.searchParams.set("background", "plain");
              link.href = target;
            }
          }

          updateThemeColor();
          updateLinks();
          matchMedia("(prefers-color-scheme: dark)").addEventListener(
            "change",
            updateThemeColor,
          );
          document.addEventListener("nerdfest:palette", ({ detail }) => {
            if (!known(detail)) return;
            root.dataset.palette = detail;
            try {
              localStorage.setItem(storageKey, detail);
            } catch {
              // Preview links retain the choice without browser storage.
            }
            const current = new URL(location.href);
            current.searchParams.set("palette", detail);
            history.replaceState(history.state, "", current);
            updateThemeColor();
            updateLinks();
          });
          document.addEventListener("nerdfest:hero-art", ({ detail }) => {
            if (!knownHero(detail)) return;
            root.dataset.heroArt = detail;
            try {
              localStorage.setItem(heroKey, detail);
            } catch {
              // Preview links retain the choice without browser storage.
            }
            const current = new URL(location.href);
            current.searchParams.set("hero", detail);
            history.replaceState(history.state, "", current);
            updateLinks();
          });
        },
        { once: true },
      );
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="masthead">
      <div class="wrap">
        <SiteMenu
          client:load
          home={onHome
            ? undefined
            : { href: home, label: preview ? "Preview homepage" : "Homepage" }}
          events={{ href: `${home}events/`, current: eventsPage }}
          about={preview ? `${base}about/` : undefined}
          presenters={preview ? `${base}presenters/` : undefined}
          directions={venueDirections}
          palettes={palettes}
          showHeroArt={onHome}
          preview={preview}
        />
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="footer">
      <div class="wrap">Nerd Fest + Expo · San Antonio, TX</div>
    </footer>
  </body>
</html>
