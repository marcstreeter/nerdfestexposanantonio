---
import { scenePath, storyScenes } from "./story-art";
---

<div class="story-art" aria-hidden="true">
  <svg
    viewBox="0 0 100 100"
    width="480"
    height="480"
    fill="none"
    focusable="false"
  >
    <path
      data-story-path
      d={scenePath(storyScenes.welcome)}
      stroke="currentColor"
      stroke-width="1.35"
      vector-effect="non-scaling-stroke"
      stroke-linecap="round"></path>
  </svg>
</div>

<script>
  import { scenePath, storyScenes, welcomeArt } from "./story-art";

  const story = document.querySelector<HTMLElement>("[data-story]");
  const art = story?.querySelector<SVGPathElement>("[data-story-path]");
  if (story && art) {
    const scenes = Array.from(
      story.querySelectorAll<HTMLElement>("[data-scene]"),
      (section) => ({
        section,
        lines: storyScenes[section.dataset.scene as keyof typeof storyScenes],
      }),
    ).filter(({ lines }) => lines);
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let anchors: number[] = [];
    let frame = 0;

    function render() {
      frame = 0;
      if (scenes.length < 2) return;
      const readingLine = scrollY + innerHeight * 0.5;
      const nextAnchor = anchors.findIndex((anchor) => anchor >= readingLine);
      const index =
        nextAnchor < 0 ? scenes.length - 2 : Math.max(0, nextAnchor - 1);
      const span = anchors[index + 1] - anchors[index];
      const position = (readingLine - anchors[index]) / span;
      const progress = Math.min(1, Math.max(0, (position - 0.16) / 0.68));
      const blend = reducedMotion.matches
        ? Number(position >= 0.5)
        : progress * progress * (3 - 2 * progress);
      const selectedArt = document.documentElement.dataset
        .heroArt as keyof typeof welcomeArt;
      const initialArt = welcomeArt[selectedArt] ?? welcomeArt.people;
      const d = scenePath(
        index === 0 ? initialArt : scenes[index].lines,
        scenes[index + 1].lines,
        blend,
      );
      if (art?.getAttribute("d") !== d) art?.setAttribute("d", d);
    }

    function schedule() {
      if (!frame) frame = requestAnimationFrame(render);
    }

    function measure() {
      anchors = scenes.map(({ section }) => {
        const box = section.getBoundingClientRect();
        return scrollY + box.top + Math.min(box.height / 2, innerHeight * 0.32);
      });
      schedule();
    }

    reducedMotion.addEventListener("change", schedule);
    document.addEventListener("nerdfest:hero-art", schedule);
    new ResizeObserver(measure).observe(story);
    addEventListener("resize", measure);
    addEventListener("scroll", schedule, { passive: true });
    measure();
  }
</script>
