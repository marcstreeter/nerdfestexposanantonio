---
import { Button } from "@/components/ui/shadcn/button";
import Select from "@components/ui/forms/Select.tsx";
import schedule from "@data/events-overall.json";
import { height, rooms, width } from "./expo-map";

const events = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/review/events/#schedule`;
const total = rooms.filter((room) => room.chip !== false).length;
---

<div class="arcade" data-arcade>
  <div class="game-header">
    <div>
      <p data-game-status aria-live="polite">
        South entrance · Chips 0 / {total}
      </p>
    </div>
    <div class="game-actions">
      <Button variant="outline" type="button" data-zoom aria-pressed="false"
        >Zoom in</Button
      >
      <Button variant="outline" type="button" data-reset>Restart</Button>
    </div>
  </div>
  <div
    class="game-board"
    tabindex="0"
    role="region"
    aria-label="Chip Run expo map"
    aria-describedby="arcade-help"
  >
    <canvas width={width * 20} height={height * 20} aria-hidden="true"></canvas>
  </div>
  <div class="game-lower">
    <div>
      <label class="room-picker">
        <span>Find a room</span>
        <Select
          data-room
          options={[
            { value: "", label: "Choose a room" },
            ...rooms.map((room, index) => ({ value: index, label: room.name })),
          ]}
        />
      </label>
      <div class="room-details" data-room-details>
        <p>
          Choose a room or tap it on the map to see a route from your current
          spot.
        </p>
      </div>
    </div>
    <div class="dpad" role="group" aria-label="Move player">
      <button type="button" data-move="ArrowUp" aria-label="Move up">↑</button>
      <button type="button" data-move="ArrowLeft" aria-label="Move left"
        >←</button
      >
      <button type="button" data-move="ArrowDown" aria-label="Move down"
        >↓</button
      >
      <button type="button" data-move="ArrowRight" aria-label="Move right"
        >→</button
      >
    </div>
  </div>
  <a class="text-link" href={events}
    >See the full event schedule <span aria-hidden="true">→</span></a
  >
  <p class="game-note">
    Simplified from the expo floor plan. Room locations are approximate.
  </p>
  <noscript><p>Enable JavaScript to explore the map.</p></noscript>
  {
    rooms.map((room, index) => {
      const sessions = schedule.items.flatMap(({ question, answer }) => {
        const [title, venue] = answer.split(" @");
        return room.scheduleVenue && venue?.startsWith(room.scheduleVenue)
          ? [{ time: question, title }]
          : [];
      });
      return (
        <template data-room-info={index}>
          <h3>{room.name}</h3>
          <p>{room.description}</p>
          {sessions.length > 0 && (
            <ul aria-label="Scheduled events in this room">
              {sessions.map(({ time, title }) => (
                <li>
                  <strong>{time}</strong> {title}
                </li>
              ))}
            </ul>
          )}
        </template>
      );
    })
  }
</div>

<script>
  import {
    canMove,
    directions,
    entrance,
    height,
    isHall,
    roomAt,
    roomCenter,
    rooms,
    routeBetween,
    samePoint,
    width,
  } from "./expo-map";
  import type { ExpoRoom, Point } from "./expo-map";

  const colors = ["#101e19", "#385846", "#82a85c", "#e2f7a1"];
  const tile = 20;
  const arcade = document.querySelector<HTMLElement>("[data-arcade]");
  if (arcade) {
    const board = arcade.querySelector<HTMLElement>(".game-board")!;
    const canvas = board.querySelector("canvas")!;
    const context = canvas.getContext("2d");
    if (context) start(arcade, board, canvas, context);
  }

  function start(
    arcade: HTMLElement,
    board: HTMLElement,
    canvas: HTMLCanvasElement,
    ctx: CanvasRenderingContext2D,
  ) {
    const status = arcade.querySelector<HTMLElement>("[data-game-status]")!;
    const picker = arcade.querySelector<HTMLSelectElement>("[data-room]")!;
    const details = arcade.querySelector<HTMLElement>("[data-room-details]")!;
    const defaultDetails = details.cloneNode(true);
    const zoom = arcade.querySelector<HTMLButtonElement>("[data-zoom]")!;
    const map = document.createElement("canvas");
    map.width = width * tile;
    map.height = height * tile;
    const mapContext = map.getContext("2d")!;
    drawFloor(mapContext);

    const total = rooms.filter((room) => room.chip !== false).length;
    const visited = new Set<ExpoRoom>();
    let position = entrance;
    let destination: ExpoRoom | undefined;
    let zoomed = false;
    let camera: Point = [0, 0];

    function paint() {
      const columns = zoomed ? 18 : width;
      const rows = zoomed ? 10 : height;
      const [x, y] = position;
      camera = [
        Math.max(0, Math.min(width - columns, x - Math.floor(columns / 2))),
        Math.max(0, Math.min(height - rows, y - Math.floor(rows / 2))),
      ];
      if (canvas.width !== columns * tile || canvas.height !== rows * tile) {
        canvas.width = columns * tile;
        canvas.height = rows * tile;
      }
      ctx.save();
      ctx.translate(-camera[0] * tile, -camera[1] * tile);
      ctx.drawImage(map, 0, 0);
      if (destination) {
        ctx.fillStyle = colors[2];
        for (const [column, row] of routeBetween(
          position,
          roomCenter(destination),
        ).slice(1)) {
          ctx.fillRect(column * tile + 8, row * tile + 8, 4, 4);
        }
        const [left, top, w, h] = destination.area;
        ctx.strokeStyle = colors[3];
        ctx.strokeRect(
          left * tile + 2.5,
          top * tile + 2.5,
          w * tile - 5,
          h * tile - 5,
        );
      }
      for (const room of rooms) {
        if (room.chip === false || visited.has(room)) continue;
        const [column, row] = roomCenter(room);
        ctx.fillStyle = colors[3];
        ctx.fillRect(column * tile + 7, row * tile + 7, 6, 6);
      }
      ctx.fillStyle = colors[0];
      ctx.fillRect(x * tile + 1, y * tile + 1, 18, 18);
      ctx.fillStyle = colors[3];
      ctx.fillRect(x * tile + 3, y * tile + 4, 14, 12);
      ctx.fillStyle = colors[0];
      ctx.fillRect(x * tile + 5, y * tile + 6, 3, 3);
      ctx.fillRect(x * tile + 12, y * tile + 6, 3, 3);
      ctx.restore();
    }

    function showRoom(room?: ExpoRoom) {
      const template =
        room &&
        arcade.querySelector<HTMLTemplateElement>(
          `[data-room-info="${rooms.indexOf(room)}"]`,
        );
      const content = template
        ? Array.from(template.content.childNodes)
        : Array.from(defaultDetails.childNodes);
      details.replaceChildren(...content.map((node) => node.cloneNode(true)));
    }

    function findRoom(room?: ExpoRoom) {
      destination = room;
      picker.value = room ? String(rooms.indexOf(room)) : "";
      showRoom(room ?? roomAt(position));
      paint();
    }

    function move([dx, dy]: Point) {
      const next: Point = [position[0] + dx, position[1] + dy];
      if (!canMove(position, next)) return;
      const previousRoom = roomAt(position);
      position = next;
      const current = roomAt(position);
      if (current && current.chip !== false) visited.add(current);
      const place =
        current?.name ??
        (samePoint(position, entrance) ? "South entrance" : "Hallway");
      const message = `${place} · ${visited.size === total ? "All activity rooms explored!" : `Chips ${visited.size} / ${total}`}`;
      if (status.textContent !== message) status.textContent = message;
      if (current && current !== previousRoom) showRoom(current);
      if (
        destination &&
        current === destination &&
        samePoint(position, roomCenter(destination))
      )
        destination = undefined;
      paint();
    }

    board.addEventListener("keydown", (event) => {
      if (!Object.hasOwn(directions, event.key)) return;
      event.preventDefault();
      move(directions[event.key as keyof typeof directions]);
    });
    for (const button of arcade.querySelectorAll<HTMLButtonElement>(
      "[data-move]",
    )) {
      button.addEventListener("click", () =>
        move(directions[button.dataset.move as keyof typeof directions]),
      );
    }
    picker.addEventListener("change", () =>
      findRoom(picker.value === "" ? undefined : rooms[Number(picker.value)]),
    );
    canvas.addEventListener("click", (event) => {
      const rect = canvas.getBoundingClientRect();
      const x = Math.floor(
        ((event.clientX - rect.left) / rect.width) * (canvas.width / tile),
      );
      const y = Math.floor(
        ((event.clientY - rect.top) / rect.height) * (canvas.height / tile),
      );
      const room = roomAt([x + camera[0], y + camera[1]]);
      if (room) findRoom(room);
    });
    zoom.addEventListener("click", () => {
      zoomed = !zoomed;
      zoom.setAttribute("aria-pressed", String(zoomed));
      zoom.textContent = zoomed ? "Zoom out" : "Zoom in";
      paint();
    });
    arcade.querySelector("[data-reset]")?.addEventListener("click", () => {
      position = entrance;
      visited.clear();
      status.textContent = `South entrance · Chips 0 / ${total}`;
      findRoom();
    });
    paint();
  }

  function drawFloor(ctx: CanvasRenderingContext2D) {
    ctx.fillStyle = colors[0];
    ctx.fillRect(0, 0, width * tile, height * tile);
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        const point: Point = [x, y];
        const room = roomAt(point);
        if (!room && !isHall(point)) continue;
        const [left, top] = [x * tile, y * tile];
        ctx.fillStyle = room ? colors[1] : colors[0];
        ctx.fillRect(left, top, tile, tile);
        ctx.fillStyle = colors[2];
        if (!canMove(point, [x - 1, y])) ctx.fillRect(left, top, 1, tile);
        if (!canMove(point, [x + 1, y]))
          ctx.fillRect(left + tile - 1, top, 1, tile);
        if (!canMove(point, [x, y - 1])) ctx.fillRect(left, top, tile, 1);
        if (!canMove(point, [x, y + 1]))
          ctx.fillRect(left, top + tile - 1, tile, 1);
      }
    }
    ctx.font = "bold 12px monospace";
    ctx.textAlign = "center";
    ctx.fillStyle = colors[3];
    for (const {
      area: [left, top, roomWidth],
      label,
    } of rooms) {
      ctx.fillText(
        label,
        (left + roomWidth / 2) * tile,
        top * tile + 15,
        roomWidth * tile - 5,
      );
    }
  }
</script>
