---
import EventAlerts from "./EventAlerts.astro";
import Select from "@components/ui/forms/Select.tsx";
import { expoEvents } from "./expo-events";
import { scenePath, storyScenes } from "./story-art";
import {
  backExit,
  canMove,
  doorwayKey,
  entrance,
  exits,
  foyers,
  halls,
  height,
  isHall,
  roomAt,
  roomCenter,
  rooms,
  samePoint,
  southFoyer,
  unprogrammedRooms,
  width,
} from "./expo-map";

interface Props {
  showEventAlerts?: boolean;
  showRoomPicker?: boolean;
}

const { showEventAlerts = true, showRoomPicker = true } = Astro.props;
const locations = [
  ...rooms,
  { name: southFoyer.name, description: "Check-in at the double doors." },
];
const exitMarkers = exits.map(({ point, edge }) => {
  const [x, y] = point;
  switch (edge) {
    case "north":
      return { line: `M${x - 0.5} ${y}h1`, x, y: y + 1.25 };
    case "east":
      return {
        line: `M${x + 1} ${y - 0.5}v1`,
        x: x - 3,
        y: y + 0.35,
        label: backExit.name.toUpperCase(),
      };
    case "south": {
      const center = samePoint(point, entrance) ? x : x + 0.5;
      return { line: `M${center - 0.5} ${y + 1}h1`, x: center, y: y - 0.1 };
    }
    case "west":
      return { line: `M${x} ${y - 0.5}v1`, x: x + 2, y: y + 0.35 };
  }
});
const doorStrokeWidth = 0.22;
const doors = rooms.flatMap(({ doors }) =>
  doors.map(([inside, hallway]) => {
    const [x, y] = inside;
    const [hallX, hallY] = hallway;
    const vertical = x !== hallX;
    return {
      key: doorwayKey(inside, hallway),
      x: Math.max(x, hallX),
      y: Math.max(y, hallY),
      line: vertical ? "M0 0v1" : "M0 0h1",
      angle: vertical ? (x < hallX ? 90 : -90) : y < hallY ? -90 : 90,
    };
  }),
);
const roomIcons = new Set(rooms.flatMap(({ icon }) => (icon ? [icon] : [])));
const walls = new Set<string>();
for (let y = 0; y < height; y++) {
  for (let x = 0; x < width; x++) {
    const point = [x, y] as const;
    if (!roomAt(point) && !isHall(point)) continue;
    if (!canMove(point, [x - 1, y])) walls.add(`M${x} ${y}v1`);
    if (!canMove(point, [x + 1, y])) walls.add(`M${x + 1} ${y}v1`);
    if (!canMove(point, [x, y - 1])) walls.add(`M${x} ${y}h1`);
    if (!canMove(point, [x, y + 1])) walls.add(`M${x} ${y + 1}h1`);
  }
}
---

<div class="arcade" data-arcade>
  <p class="sr-only" data-game-status aria-live="polite">{southFoyer.name}</p>
  <div
    class="game-board"
    tabindex="0"
    role="region"
    aria-labelledby="expo-map-title"
    aria-describedby="arcade-help"
  >
    <svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
      <defs>
        {
          [...roomIcons].map((icon) => (
            <path
              id={`expo-map-icon-${icon}`}
              d={scenePath(storyScenes[icon])}
            />
          ))
        }
        <g id="expo-map-icon-restroom-women">
          <circle cx="50" cy="17" r="10"></circle>
          <path
            d="M21 62l11-24q3-6 10-6h16q7 0 10 6l11 24 M40 43L30 70h40L60 43 M44 70v22m12-22v22"
          ></path>
        </g>
        <g id="expo-map-icon-restroom-men">
          <circle cx="50" cy="17" r="10"></circle>
          <path
            d="M21 62V42q0-10 10-10h38q10 0 10 10v20 M39 44v48h22V44 M50 68v24"
          ></path>
        </g>
        <g id="expo-map-icon-restroom-family">
          <circle cx="34" cy="20" r="10"></circle>
          <circle cx="71" cy="40" r="8"></circle>
          <path
            d="M13 60l8-18q2-6 9-6h10q6 0 9 6l10 17 M25 51v40m18-40v40 M55 68l7-11q2-4 6-4h7q4 0 6 4l7 11 M65 65v26m12-26v26"
          ></path>
        </g>
      </defs>
      <g fill="var(--map-hall, #263b30)">
        {halls.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
      </g>
      <g
        fill="var(--map-unused-room, #202c26)"
        stroke="var(--map-unused-wall, #607266)"
        stroke-width=".08"
      >
        {
          unprogrammedRooms.map(([x, y, w, h]) => (
            <rect x={x} y={y} width={w} height={h} />
          ))
        }
      </g>
      {
        rooms.map(({ icon, amenity, area: [x, y, w, h], label }, index) => {
          const motif = amenity ?? icon;
          const labelHeight = 1.5;
          const iconAreaHeight = h - labelHeight;
          const size = Math.min(w - 0.4, iconAreaHeight, 4.5);
          const left = x + (w - size) / 2;
          const top = y + labelHeight + (iconAreaHeight - size) / 2;
          const ink = amenity
            ? "var(--map-amenity-ink, #b2f4ff)"
            : "var(--map-ink, #e2f7a1)";
          return (
            <g data-map-room={index}>
              <rect
                x={x}
                y={y}
                width={w}
                height={h}
                fill={
                  amenity
                    ? "var(--map-amenity, #30565a)"
                    : "var(--map-room, #385846)"
                }
              />
              {motif && (
                <use
                  href={`#expo-map-icon-${motif}`}
                  stroke={ink}
                  stroke-width={amenity ? 4.5 : 2.5}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                  opacity={amenity ? 1 : 0.72}
                  transform={`translate(${left} ${top}) scale(${size / 100})`}
                  pointer-events="none"
                />
              )}
              <text
                class="game-map-labels"
                x={x + w / 2}
                y={y + 1.3}
                fill={ink}
                text-anchor="middle"
              >
                {label}
              </text>
            </g>
          );
        })
      }
      <path
        d={[...walls].join("")}
        fill="none"
        stroke="var(--map-wall, #82a85c)"
        stroke-width=".1"></path>
      <g
        class="game-map-labels"
        fill="var(--map-ink, #e2f7a1)"
        text-anchor="middle"
      >
        {
          foyers.map(({ name, area: [x, y, w, h] }) => (
            <text x={x + w / 2} y={y + h / 2}>
              {name
                .toUpperCase()
                .split(" ")
                .map((word, index) => (
                  <tspan x={x + w / 2} dy={index === 0 ? 0 : 1.25}>
                    {word}
                  </tspan>
                ))}
            </text>
          ))
        }
      </g>
      <g
        class="game-map-labels"
        fill="var(--map-exit, #ffe1a3)"
        text-anchor="middle"
      >
        {
          exitMarkers.map(({ line, x, y, label = "EXIT" }) => (
            <g data-map-exit>
              <path
                d={line}
                stroke="var(--map-exit, #ffe1a3)"
                stroke-width={doorStrokeWidth}
              />
              <text x={x} y={y}>
                {label}
              </text>
            </g>
          ))
        }
      </g>
      <path data-map-trail fill="var(--map-trail, #82a85c)"></path>
      <rect
        data-map-target
        fill="none"
        stroke="var(--map-target, #e2f7a1)"
        stroke-width=".1"
        visibility="hidden"></rect>
      <g
        fill="none"
        stroke="var(--map-door, #a9ca7e)"
        stroke-width={doorStrokeWidth}
        pointer-events="none"
      >
        {
          doors.map(({ key, x, y, line, angle }) => (
            <g transform={`translate(${x} ${y})`}>
              <path
                d={line}
                data-map-door={key}
                data-swing-angle={angle}
                transform-origin="0 0"
              />
            </g>
          ))
        }
      </g>
      <g
        data-map-player
        class="game-map-player"
        style={`transform: translate(${entrance[0]}px, ${entrance[1]}px)`}
      >
        <g transform="translate(.5 .5) scale(1.65) translate(-.5 -.5)">
          <rect
            x=".05"
            y=".05"
            width=".9"
            height=".9"
            fill="var(--map-bot-outline, #101e19)"></rect>
          <rect
            x=".15"
            y=".2"
            width=".7"
            height=".6"
            fill="var(--map-bot, #e2f7a1)"></rect>
          <path
            d="M.25 .3h.15v.15h-.15z M.6 .3h.15v.15h-.15z"
            fill="var(--map-bot-outline, #101e19)"></path>
        </g>
      </g>
    </svg>
  </div>
  <div class="room-details" data-room-details>
    <div class="map-toolbar">
      <h3 data-room-title hidden></h3>
      {
        showRoomPicker && (
          <Select
            id="expo-room-picker"
            aria-label="Find a Room"
            defaultValue=""
            options={[
              { value: "", label: "Find a Room", disabled: true },
              ...rooms.map((room, index) => ({
                value: index,
                label: room.name,
              })),
            ]}
          />
        )
      }
    </div>
    <div data-room-content></div>
  </div>
  <div data-alerts-home hidden>
    <div data-alerts-slot>{showEventAlerts && <EventAlerts />}</div>
  </div>
  <noscript><p>Enable JavaScript to explore the map.</p></noscript>
  {
    locations.map((room, index) => {
      const place = index === rooms.length ? "entrance" : room.name;
      const sessions = expoEvents.filter((event) => event.room === place);
      return (
        <template data-room-info={index} data-room-name={room.name}>
          <p>{room.description}</p>
          {sessions.length > 0 && (
            <ul class="room-activities" aria-label="Activities in this room">
              {sessions.map(
                ({
                  time,
                  title,
                  id,
                  description,
                  hosts,
                  venue,
                  speakerBios,
                }) => (
                  <li data-room-event={id}>
                    <h4 tabindex="-1">
                      <a
                        class="text-link"
                        href={`?event=${id}#arcade`}
                        data-open-event={id}
                      >
                        {title}
                      </a>
                    </h4>
                    <p class="room-event-summary">
                      {[time, ...hosts].join(" · ")}
                    </p>
                    <div class="room-event-description" hidden>
                      <p>{description}</p>
                      <dl>
                        <dt>Where</dt>
                        <dd>{venue}</dd>
                        <dt>When</dt>
                        <dd>{time}</dd>
                        <dt>Who</dt>
                        <dd>
                          {hosts.length ? hosts.join(", ") : "Host not listed"}
                        </dd>
                      </dl>
                      {hosts.map((host) => {
                        const bio = speakerBios?.[host];
                        return (
                          bio && (
                            <div class="speaker-bio">
                              <h5>About {host}</h5>
                              <p>{bio}</p>
                            </div>
                          )
                        );
                      })}
                    </div>
                  </li>
                ),
              )}
            </ul>
          )}
        </template>
      );
    })
  }
</div>

<script>
  import {
    areaNameAt,
    canMove,
    directions,
    doorwayKey,
    entrance,
    height,
    isHall,
    roomAt,
    roomCenter,
    rooms,
    routeBetween,
    samePoint,
    width,
  } from "./expo-map";
  import type { ExpoRoom, Point } from "./expo-map";
  import { expoEvents } from "./expo-events";

  const stepInterval = 65;
  const arcade = document.querySelector<HTMLElement>("[data-arcade]");
  if (arcade) {
    const board = arcade.querySelector<HTMLElement>(".game-board")!;
    const map = board.querySelector("svg")!;
    start(arcade, board, map);
  }

  function start(arcade: HTMLElement, board: HTMLElement, map: SVGSVGElement) {
    const status = arcade.querySelector<HTMLElement>("[data-game-status]")!;
    const picker = arcade.querySelector<HTMLSelectElement>("#expo-room-picker");
    const roomTitle = arcade.querySelector<HTMLElement>("[data-room-title]")!;
    const details = arcade.querySelector<HTMLElement>("[data-room-content]")!;
    const alertsHome = arcade.querySelector<HTMLElement>("[data-alerts-home]")!;
    const alertsSlot = arcade.querySelector<HTMLElement>("[data-alerts-slot]")!;

    const player = map.querySelector<SVGGElement>("[data-map-player]")!;
    const trail = map.querySelector<SVGPathElement>("[data-map-trail]")!;
    const outline = map.querySelector<SVGRectElement>("[data-map-target]")!;

    const doors = new Map(
      Array.from(
        map.querySelectorAll<SVGPathElement>("[data-map-door]"),
        (door) => [door.dataset.mapDoor!, door],
      ),
    );
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    let position = entrance;
    let destination: ExpoRoom | undefined;
    let headingToEntrance = false;
    let visibleRoom: number | undefined;
    let selectedEvent: string | undefined;
    let walking: Point[] = [];
    let walkTimer: number | undefined;

    function paint() {
      const [x, y] = position;
      player.style.transform = `translate(${x}px, ${y}px)`;
      const target =
        walking.at(-1) ??
        (destination
          ? roomCenter(destination)
          : headingToEntrance
            ? entrance
            : undefined);

      const steps = walking.length
        ? walking
        : target
          ? routeBetween(position, target).slice(1)
          : [];
      trail.setAttribute(
        "d",
        steps
          .map(
            ([column, row]) => `M${column + 0.34} ${row + 0.34}h.32v.32h-.32z`,
          )
          .join(""),
      );

      outline.setAttribute("visibility", target ? "visible" : "hidden");
      if (target) {
        const [left, top, w, h] = destination?.area ?? [...target, 1, 1];
        outline.setAttribute("x", String(left + 0.125));
        outline.setAttribute("y", String(top + 0.125));
        outline.setAttribute("width", String(w - 0.25));
        outline.setAttribute("height", String(h - 0.25));
      }
    }

    function showRoom(room?: ExpoRoom, atEntrance = false, eventId?: string) {
      const index = atEntrance
        ? rooms.length
        : room
          ? rooms.indexOf(room)
          : undefined;
      if (index === visibleRoom && eventId === selectedEvent) return;

      alertsHome.append(alertsSlot);
      if (index !== visibleRoom) {
        const template = arcade.querySelector<HTMLTemplateElement>(
          `[data-room-info="${index}"]`,
        );
        roomTitle.textContent = template?.dataset.roomName ?? "";
        roomTitle.hidden = !template;
        if (template) details.replaceChildren(template.content.cloneNode(true));
        else details.replaceChildren();
        map
          .querySelector("[data-map-room][data-focused]")
          ?.removeAttribute("data-focused");
        const focused = map.querySelector(`[data-map-room="${index}"]`);
        focused?.setAttribute("data-focused", "");
        map.toggleAttribute("data-room-focus", Boolean(focused));
        visibleRoom = index;
      }

      for (const activity of details.querySelectorAll<HTMLElement>(
        "[data-room-event]",
      )) {
        const selected = activity.dataset.roomEvent === eventId;
        const link = activity.querySelector("a")!;
        const description = activity.querySelector<HTMLElement>(
          ".room-event-description",
        )!;
        activity.toggleAttribute("data-selected", selected);
        description.hidden = !selected;
        if (selected) {
          link.setAttribute("aria-current", "true");
          description.append(alertsSlot);
        } else {
          link.removeAttribute("aria-current");
        }
      }

      if (eventId !== selectedEvent) {
        selectedEvent = eventId;
        document.dispatchEvent(
          new CustomEvent("nerdfest:event-selected", { detail: eventId ?? "" }),
        );
      }
    }

    function findRoom(room?: ExpoRoom, atEntrance = false, eventId?: string) {
      stopWalking();
      destination = room;
      headingToEntrance = atEntrance;
      const shown = atEntrance ? undefined : (room ?? roomAt(position));
      const sameRoom =
        visibleRoom ===
        (atEntrance ? rooms.length : shown ? rooms.indexOf(shown) : undefined);
      if (!eventId && selectedEvent && !sameRoom) {
        const url = new URL(location.href);
        url.searchParams.delete("event");
        history.replaceState(history.state, "", url);
      }
      showRoom(
        shown,
        atEntrance,
        eventId ?? (sameRoom ? selectedEvent : undefined),
      );
      paint();
    }

    function swingDoor(from: Point, to: Point) {
      if (reducedMotion.matches) return;
      const door = doors.get(doorwayKey(from, to));
      if (!door) return;

      for (const animation of door.getAnimations()) animation.cancel();
      const open = `rotate(${door.dataset.swingAngle}deg)`;
      door.animate(
        [
          { transform: "rotate(0deg)" },
          { transform: open, offset: 0.2 },
          { transform: open, offset: 0.55 },
          { transform: "rotate(0deg)" },
        ],
        320,
      );
    }

    function move([dx, dy]: Point) {
      const next: Point = [position[0] + dx, position[1] + dy];
      if (!canMove(position, next)) return false;
      const previousRoom = roomAt(position);
      const current = roomAt(next);
      if (current !== previousRoom) swingDoor(position, next);
      position = next;
      const place = current?.name ?? areaNameAt(position) ?? "Hallway";
      if (status.textContent !== place) status.textContent = place;
      if (!selectedEvent && !destination && current && current !== previousRoom)
        showRoom(current);
      if (
        destination &&
        current === destination &&
        samePoint(position, roomCenter(destination))
      )
        destination = undefined;
      paint();
      return true;
    }

    function stopWalking() {
      window.clearTimeout(walkTimer);
      walkTimer = undefined;
      walking = [];
    }

    function walkStep() {
      walkTimer = undefined;
      const next = walking.shift();
      if (!next) return;
      if (!walking.length) {
        destination = undefined;
        headingToEntrance = false;
      }
      if (!move([next[0] - position[0], next[1] - position[1]])) {
        stopWalking();
        paint();
      } else if (walking.length) {
        walkTimer = window.setTimeout(walkStep, stepInterval);
      }
    }

    function walkTo(point: Point, room?: ExpoRoom, eventId?: string) {
      findRoom(room, samePoint(point, entrance), eventId);
      walking = routeBetween(position, point).slice(1);
      if (!walking.length) return;
      paint();
      walkTimer = window.setTimeout(walkStep, stepInterval);
    }

    function moveManually(direction: Point) {
      stopWalking();
      if (!move(direction)) paint();
    }

    const eventsById = new Map(expoEvents.map((event) => [event.id, event]));

    function selectEventFromUrl(shouldWalk = false) {
      const id = new URL(location.href).searchParams.get("event");
      const event = id && eventsById.get(id);
      if (!event) {
        if (selectedEvent) showRoom(destination, headingToEntrance);
        return;
      }

      const room = rooms.find(({ name }) => name === event.room);
      const atEntrance = event.room === "entrance";
      const target = room
        ? roomCenter(room)
        : atEntrance
          ? entrance
          : undefined;
      if (shouldWalk && target) {
        walkTo(target, room, event.id);
      } else {
        findRoom(room, atEntrance, event.id);
      }
    }

    document.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        !(event.target instanceof Element)
      )
        return;
      const link =
        event.target.closest<HTMLAnchorElement>("a[data-open-event]");
      const id = link?.dataset.openEvent;
      if (!id || !eventsById.has(id)) return;

      event.preventDefault();
      const fromMap = arcade.contains(link);
      const url = new URL(location.href);
      url.searchParams.set("event", id);
      url.hash = "arcade";
      if (url.href !== location.href) history.pushState(history.state, "", url);
      selectEventFromUrl(!fromMap);

      const heading = details.querySelector<HTMLElement>("[data-selected] h4");
      if (!fromMap) {
        board.scrollIntoView({ block: "start" });
        heading?.focus({ preventScroll: true });
      } else {
        heading?.focus();
      }
    });

    addEventListener("popstate", () => selectEventFromUrl());
    selectEventFromUrl();

    board.addEventListener("keydown", (event) => {
      if (!Object.hasOwn(directions, event.key)) return;
      event.preventDefault();
      moveManually(directions[event.key as keyof typeof directions]);
    });
    picker?.addEventListener("change", () => {
      if (picker.value === "") return;
      const room = rooms[Number(picker.value)];
      picker.value = "";
      findRoom(room);
    });
    map.addEventListener("click", (event) => {
      const rect = map.getBoundingClientRect();
      const x = Math.floor(((event.clientX - rect.left) / rect.width) * width);
      const y = Math.floor(((event.clientY - rect.top) / rect.height) * height);
      const point: Point = [x, y];
      const room = roomAt(point);
      if (room || isHall(point)) {
        walkTo(point, room);
      } else {
        stopWalking();
        paint();
      }
    });
    paint();
  }
</script>
