---
import Arcade from "@components/review/Arcade.astro";
import ExpoLineArt from "@components/review/ExpoLineArt.astro";
import ReviewLayout from "@components/review/ReviewLayout.astro";
import { expoEvents } from "@components/review/expo-events";
import { buttonVariants } from "@/components/ui/shadcn/button";
---

<ReviewLayout title="Events & exhibits">
  <section class="world expo-hero events-hero">
    <ExpoLineArt />
    <div class="wrap section">
      <p class="eyebrow">Nerd Fest + Expo</p>
      <h1 class="events-title">Events &amp; <em>exhibits</em></h1>
      <p class="intro">
        Choose an activity to see its details and find its room on the map.
      </p>
    </div>
  </section>
  <section
    class="world circuitry"
    id="schedule"
    aria-label="Schedule and exhibits"
  >
    <div class="wrap section events-schedule">
      <ul class="event-list">
        {
          expoEvents.map(({ id, kind, time, title, venue, hosts, room }) => (
            <li class="event-card" data-event={id}>
              <span class="event-time">
                {kind === "exhibit" ? "Exhibit" : time}
              </span>
              <div>
                <h2>
                  {room === "entrance" ? (
                    title
                  ) : (
                    <a href={`?event=${id}#arcade`} data-open-event={id}>
                      {title}
                    </a>
                  )}
                </h2>
                <p>{[venue, ...hosts].join(" · ")}</p>
              </div>
              {room !== "entrance" && (
                <a
                  class={buttonVariants({ variant: "outline" })}
                  href={`?event=${id}#arcade`}
                  data-open-event={id}
                  aria-label={`Find ${title} on the map`}
                >
                  Find on map
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section class="world circuitry" id="arcade">
    <div class="wrap section">
      <h2 id="expo-map-title">Expo Map</h2>
      <p class="intro" id="arcade-help">Tap room for details.</p>
      <Arcade />
    </div>
  </section>
</ReviewLayout>

<style>
  .events-hero .section {
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }
  .events-schedule {
    padding-block-start: 0.75rem;
  }
  .event-card h2 a {
    color: inherit;
    text-underline-offset: 0.18em;
  }
</style>
